# embedding-mcp tunables — copy to .env and edit. setup.sh reads this file.
# Pinned llama.cpp release (CUDA prebuilt for ubuntu/cuda-12.8/x64)
LLAMA_TAG=b11551
# Model repo + quant (llama.cpp -hf format)
EMBED_MODEL_REPO=unsloth/embeddinggemma-2-GGUF
EMBED_QUANT=UD-Q4_K_XL
# Ports
LLAMA_PORT=8080
MCP_PORT=8090
MCP_HOST=0.0.0.0
MCP_PATH=/mcp
# Server knobs (setup.sh computes hardware-aware defaults if left as auto)
LLAMA_CTX=auto
LLAMA_PARALLEL=auto
LLAMA_UBATCH=2048
# MCP limits
EMBED_MAX_TEXTS=32
EMBED_MAX_TEXT_CHARS=8000
EMBED_MAX_MEDIA_BYTES=10485760
EMBED_TIMEOUT_SECONDS=120
# Firewall subnet (printed for operator approval; never auto-applied)
LAN_SUBNET=10.223.223.0/24
